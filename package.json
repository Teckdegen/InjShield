{
  "name": "injshield",
  "version": "1.0.0",
  "description": "Private payments on Injective via client-side AES-256-GCM encryption with relayer abstraction",
  "scripts": {
    "compile": "npx hardhat compile",
    "deploy": "npx hardhat run scripts/deploy.js --network injectiveTestnet",
    "relayer": "node relayer/server.js",
    "frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run relayer\" \"npm run frontend\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "io-ts": "^2.2.22"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "concurrently": "^8.2.2",
    "hardhat": "^2.22.2",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  }
}
