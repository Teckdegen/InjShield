# Deployer wallet private key (with 0x prefix)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Relayer wallet private key — use a SEPARATE wallet from the deployer
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY_HERE

# Address of the relayer wallet (derived from RELAYER_PRIVATE_KEY)
RELAYER_ADDRESS=0xYOUR_RELAYER_ADDRESS_HERE

# Deployed contract address (fill after running deploy)
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# Injective EVM RPC
RPC_URL=https://inevm-rpc.testnet.injective.network

# Allowed frontend origin for the relayer (CORS)
CORS_ORIGIN=http://localhost:3000
